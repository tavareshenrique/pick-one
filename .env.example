# Obrigatório
TMDB_TOKEN=            # Read Access Token do TMDB (v4), com ou sem "Bearer "

# IA (opcional, cada chave liga uma camada)
TYPESAFE_API_KEY=                 # Jev: leitura do texto livre e ranking
GOOGLE_GENERATIVE_AI_API_KEY=     # Gemini: "por que esse filme" e mensagem de apoio

# Anti-abuso (a IA só roda se o Upstash estiver configurado)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AI_DAILY_LIMIT=800                # teto global de indicações por IA por dia

# Opcional: origens extras aceitas (separadas por vírgula)
ALLOWED_ORIGINS=

# Opcional: cadeia de modelos do Gemini, tentados em ordem
GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest

# Só dev local: libera IA sem Redis (ignorado em produção)
ALLOW_AI_WITHOUT_REDIS=
